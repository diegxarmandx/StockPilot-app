FROM eclipse-temurin:21-jdk-jammy AS build
WORKDIR /build
COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN chmod +x mvnw
COPY src src
# Tests run separately against isolated databases; image builds need no DB credentials.
RUN ./mvnw -B -ntp -DskipTests package

FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
RUN groupadd --gid 10001 stockpilot && useradd --uid 10001 --gid stockpilot --no-create-home stockpilot
COPY --from=build --chown=10001:10001 /build/target/stockpilot-0.1.0-SNAPSHOT.jar app.jar
ENV SPRING_PROFILES_ACTIVE=prod SEED_DATA_ENABLED=false SHOW_SQL=false
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
