# Primary development database: Supabase PostgreSQL.
# Fill these locally. DB_URL must be a PostgreSQL JDBC URL; keep credentials separate.
# Quote values when using this file with the Bash helper (URLs may contain &).
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Local port. Vercel uses PORT=8080; leave SERVER_PORT unset there.
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SHOW_SQL=false
# Seeding requires BOTH profile dev and SEED_DATA_ENABLED=true; off by default.
SPRING_PROFILES_ACTIVE=
SEED_DATA_ENABLED=false
# The only API configuration sent to the browser; never put DB credentials in VITE_ vars.
VITE_API_BASE_URL=http://localhost:8080

# Optional Docker fallback. Kept separate so Compose never uses Supabase credentials.
LOCAL_DB_NAME=stockpilot
LOCAL_DB_USERNAME=stockpilot
LOCAL_DB_PASSWORD=
LOCAL_DB_PORT=5432

# Optional tests: use a dedicated disposable LOCAL database, never your Supabase project.
# TEST_DB_URL=
# TEST_DB_USERNAME=
# TEST_DB_PASSWORD=
# E2E_ALLOW_WRITES=false
# E2E_BASE_URL=http://127.0.0.1:5173
# E2E_API_BASE_URL=http://localhost:8080
# PW_CHANNEL=chrome
